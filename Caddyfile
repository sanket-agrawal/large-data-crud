# Configuration for Caddy Reverse Proxy with Automatic SSL (HTTPS)
# Replace 'your-email@example.com' with your actual email (used for Let's Encrypt certificates expiration notifications)
# Replace 'yourdomain.com' and 'www.yourdomain.com' with your actual domain names

{
    email manager-email@example.com
}

ventoriocapital.com {
    # Reverse proxy all requests to the FastAPI application container on port 8000
    reverse_proxy app:8000
    
    # Enable compression for faster response times
    encode gzip zstd
}
