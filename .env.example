# ==========================================
# Production Configuration (.env)
# Hostinger VPS & Cloudflare Deployment
# ==========================================

# Subdomain & SSL (Cloudflare DNS A record should point to VPS IP)
DOMAIN_NAME=vehicle.sanketagrawal.com
SSL_EMAIL=dayamapratik43@gmail.com

# PostgreSQL Credentials (Auth DB)
POSTGRES_DB=auth_db
POSTGRES_USER=appuser
POSTGRES_PASSWORD=ChangeThisToASecureDbPassword2026!

# Admin Account Credentials
ADMIN_EMAIL=dayamapratik43@gmail.com
ADMIN_PASSWORD=AdminSecurePass2026!

# Default Master Password assigned to new users
# (Users will be required to change this upon first login)
DEFAULT_MASTER_PASSWORD=Pass@123456

# DuckDB Database Location
DUCKDB_PATH=/app/data/records.duckdb

